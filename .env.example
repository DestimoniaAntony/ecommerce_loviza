# ==========================================
# CommerceHub Production Environment Variables
# ==========================================
# Save this file as ".env" (without the .example) on your production server.
# Do NOT commit the real ".env" file to Git.

# --- Security ---
# Generate a secure random key for production. Do not share it!
SECRET_KEY=generate_a_very_long_secure_random_string_here

# Ensure this is set to False in production
DEBUG=False

# The exact subdomain(s) the application will run on
ALLOWED_HOSTS=loviza.cakesbydestisimi.com,127.0.0.1,localhost

# --- Database Setup (Optional) ---
# If you are using PostgreSQL, format: postgres://USER:PASSWORD@HOST:PORT/NAME
# If left blank, Django will fallback to using the local db.sqlite3
DATABASE_URL=postgres://myuser:mypassword@localhost:5432/commercehub_db

# --- Media & Static Files ---
# If using AWS S3 for media storage, fill these in
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=

# --- Email Configuration ---
# Use django.core.mail.backends.smtp.EmailBackend for live SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@loviza.shop
EMAIL_HOST_PASSWORD=Qatar@786
DEFAULT_FROM_EMAIL=info@loviza.shop
